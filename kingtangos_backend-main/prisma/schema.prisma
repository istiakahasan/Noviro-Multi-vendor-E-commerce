generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// MODELS
//////////////////////////////////////////////////////

model Admin {
  createdAt DateTime @default(now())
  email     String   @unique
  id        String   @id @default(uuid())
  nickName  String   @unique
  password  String
  role      UserRole @default(ADMIN)
  updatedAt DateTime @updatedAt
  userId    String   @unique
}

model Address {
  id          String      @id @default(uuid())
  name        String
  state       String?
  userId      String
  city        String?
  addressType AddressType
  postcode    String?
  country     String
  email       String
  phone       String // Better to keep as String instead of Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Availability {
  id           String    @id @default(uuid())
  specialistId String
  dayOfWeek    DayOfWeek // Enum (Monday, Tuesday, etc.)
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  specialist Specialist @relation(fields: [specialistId], references: [id])
}

model Brand {
  id          String    @id @default(uuid())
  title       String
  logoUrl     String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Product     Product[]
}

model Booking {
  id              String        @id @default(uuid())
  serviceId       String        @unique
  customerId      String
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(uuid())
  title       String
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  type         CouponType
  discount     Int
  couponStatus CouponStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  Order        Order[]
}

model Notification {
  id         String   @id @default(uuid())
  body       String
  content    String?
  createdAt  DateTime @default(now())
  goTo       String?
  isRead     Boolean  @default(false)
  message    String
  receiverId String
  senderId   String?
  title      String
  type       String?
  updatedAt  DateTime @updatedAt
}

model OTP {
  id        String   @id @default(uuid())
  expiry    DateTime
  otpCode   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, otpCode])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String
  subTotal        Int
  discount        Int         @default(0)
  shippingCost    Int         @default(0)
  total           Int
  isBlocked       Boolean     @default(false)
  orderStatus     OrderStatus @default(PENDING)
  shippingAddress String
  billingAddress  String
  couponId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  customer User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Int
  totalPrice Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Package {
  id               String         @id @default(uuid())
  name             String
  description      String
  price            Int
  currency         Currency
  recurringPriceId String?
  oneTimePriceId   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  PackageItem      PackageItem[]
  Subscription     Subscription[]
}

model PackageItem {
  id        String   @id @default(uuid())
  productId String?
  serviceId String?
  packageId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  package Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Product {
  id                 String           @id @default(uuid())
  brandId            String
  color              String?
  condition          ProductCondition
  createdBy          String
  currency           ProductCurrency
  description        String
  eligibleReturnDays Int
  inStocks           Boolean
  isDeleted          Boolean          @default(false)
  model              String
  productImages      String[]
  productName        String
  shipsFrom          String
  size               String?
  slug               String           @unique
  status             ProductStatus
  storeId            String
  subcategoryId      String
  tags               String[]
  totalStock         Int
  uniqueId           String           @unique
  warranty           Boolean
  warrantyDate       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  // relations
  brand              Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  creator            User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  subcategory        Subcategory      @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  Review             Review[]
  PackageItem        PackageItem[]
  Shipment           Shipment[]
  OrderItem          OrderItem[]
}

model Review {
  id           String      @id @default(uuid())
  comment      String
  rating       Int
  productId    String?
  specialistId String?
  serviceId    String?
  storeId      String?
  // relations
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  specialist   Specialist? @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  service      Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  store        Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Service {
  id            String      @id @default(uuid())
  serviceName   String
  price         Float
  slug          String      @unique
  subcategoryId String
  storeId       String
  location      String?
  createdBy     String
  tags          String[]
  isDeleted     Boolean     @default(false)
  specialistId  String?
  currency      Currency
  serviceMode   ServiceMode
  serviceType   ServiceType
  serviceImages String[]
  description   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  store        Store          @relation(fields: [storeId], references: [id])
  subcategory  Subcategory    @relation(fields: [subcategoryId], references: [id])
  Specialist   Specialist[]
  Review       Review[]
  PackageItem  PackageItem[]
  Subscription Subscription[]
  Booking      Booking?
}

model Store {
  id          String    @id @default(uuid())
  storeName   String
  description String
  tags        String[]
  logoURL     String
  coverImgURL String?
  ownerId     String
  address     String?
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Relations
  owner       User      @relation(fields: [ownerId], references: [id])
  services    Service[] // All services offered by this store
  Product     Product[]
  Review      Review[]
}

model Subcategory {
  id             String    @id @default(uuid())
  title          String
  logoUrl        String?
  isVisible      Boolean   @default(true)
  vat            Float     @default(0)
  tags           String[]
  specifications String[]
  totalItems     Int?      @default(0)
  description    String?
  products       Product[]
  Service        Service[]
}

model Subscription {
  id               String           @id @default(uuid())
  userId           String
  subscriptionType SubscriptionType
  packageId        String?
  serviceId        String?
  currency         Currency
  recurringPriceId String?
  oneTimePriceId   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Specialist {
  id               String      @id @default(uuid())
  bio              String
  userId           String      @unique
  profession       Profession
  tags             String[]
  expertise        String[]
  serviceId        String?
  experienceYears  Int
  sessionDuration  Int
  isActive         Boolean     @default(true)
  price            Float
  pricingType      PricingType
  isResetPassword  Boolean     @default(false)
  canResetPassword Boolean     @default(false)
  location         String?
  isDeleted        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  user         User           @relation(fields: [userId], references: [id])
  service      Service?       @relation(fields: [serviceId], references: [id])
  availability Availability[]
  Review       Review[]
}

model Shipment {
  id            String         @id @default(uuid())
  productId     String
  totalItems    Int
  totalPrice    Int
  shippingOffer String
  destination   String
  time          DateTime
  productWeight Float
  dimensionUnit DimensionUnit
  status        ShipmentStatus
  endDate       DateTime
  updatedAt     DateTime       @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model User {
  id               String         @id @default(uuid())
  about            String?
  createdAt        DateTime       @default(now())
  firstName        String
  lastName         String
  email            String         @unique
  fcmToken         String?
  isDeleted        Boolean        @default(false)
  isVerified       Boolean        @default(false)
  password         String?
  phoneNumber      String?
  profileImage     String         @default("")
  role             UserRole       @default(USER)
  status           UserStatus     @default(ACTIVE)
  updatedAt        DateTime       @updatedAt
  isResetPassword  Boolean        @default(false)
  canResetPassword Boolean        @default(false)
  product          Product[]
  Subscription     Subscription[]
  Store            Store[]
  Specialist       Specialist?
  Address          Address[]
  Order            Order[]
  Booking          Booking[]

  @@map("users")
}

// ENUMS
enum AddressType {
  BILLING
  SHIPPING
}

enum Currency {
  EUR
  GBP
  LYD
  USD
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  USED
  INACTIVE
}

enum DimensionUnit {
  KG
  GRAM
  LBS
  TON
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ProductCurrency {
  BDT
  EUR
  USD
}

enum ProductStatus {
  ACTIVE
  DRAFT
  INACTIVE
}

enum SubscriptionType {
  PRODUCT
  SERVICE
  PACKAGE
  MEMBERSHIP
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  INACTIVE
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  SELLER
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum ServiceMode {
  ONLINE
  OFFLINE
  BOTH
}

enum ServiceType {
  BASIC
  PREMIUM
  CUSTOM
}

enum Profession {
  DOCTOR
  THERAPIST
  COACH
  CONSULTANT
  OTHER
}

enum PricingType {
  HOURLY
  SESSION
  PACKAGE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
